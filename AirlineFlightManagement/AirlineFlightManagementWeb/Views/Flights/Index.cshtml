@model IEnumerable<AirlineFlightManagement.Models.Models.Flight>
@{
    ViewData["Title"] = "Căutare Zboruri";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary"><i class="bi bi-airplane-engines"></i> Căutare Zboruri</h2>

    <!-- Formularul de Search Public -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-controller="Flights" asp-action="Index" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-4">
                    <label class="visually-hidden" for="source">Plecare din</label>
                    <input type="text" class="form-control" id="source" name="source" value="@ViewBag.Source" placeholder="Plecare (ex. Bucuresti)">
                </div>
                <div class="col-sm-4">
                    <label class="visually-hidden" for="destination">Destinație</label>
                    <input type="text" class="form-control" id="destination" name="destination" value="@ViewBag.Destination" placeholder="Destinatie (ex. Londra)">
                </div>
                <!-- Pe viitor vei adăuga și câmp pentru Dată -->
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Caută Zboruri</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de Zboruri Găsite (Flight List) -->
    <h4>Rezultate pentru ruta: @ViewBag.Source ➔ @ViewBag.Destination</h4>

    @if(Model != null && Model.Any())
    {
        <div class="row mt-4">
            @foreach(var flight in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom border-light">
                            <strong>@flight.AirlineName</strong>
                            <span class="badge bg-success">@flight.Status</span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between text-center mb-3">
                                <div>
                                    <h5 class="mb-0">@flight.DepartureTime.ToString("HH:mm")</h5>
                                    <small class="text-muted">@flight.Source</small>
                                </div>
                                <div class="px-2 w-100 mt-2">
                                    <hr class="border-secondary mb-1">
                                    <small class="text-muted">✈</small>
                                </div>
                                <div>
                                    <h5 class="mb-0">@flight.ArrivalTime.ToString("HH:mm")</h5>
                                    <small class="text-muted">@flight.Destination</small>
                                </div>
                            </div>

                            <h6 class="mt-3 text-muted">Alege clasa:</h6>
                            <ul class="list-group list-group-flush">
                                @foreach(var fc in flight.FlightClasses)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        @fc.ClassName
                                        <!-- Aici se vede prețul modificat (+25$ Markup) -->
                                        <span class="fw-bold text-primary">€@fc.Price.ToString("0.00")</span> 
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <!-- Aici vine View-ul de Details indicat de cerință -->
                            <a href="#" class="btn btn-outline-primary w-100">Vezi Detalii & Rezervă</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">Nu am găsit zboruri disponibile pentru această rută.</div>
    }
</div>