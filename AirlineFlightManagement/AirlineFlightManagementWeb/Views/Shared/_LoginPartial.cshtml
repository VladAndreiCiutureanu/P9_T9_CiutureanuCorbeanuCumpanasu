@using Microsoft.AspNetCore.Identity
@using AirlineFlightManagement.Models.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Administrator");
    var isStaff = User.IsInRole("Staff");

    if (isAdmin || isStaff)
    {
        // Admin are prioritate la eticheta — daca user-ul are ambele roluri,
        // afisam (Admin). Staff-only vede (Staff).
        var roleLabel = isAdmin ? "Admin" : "Staff";

        <li class="nav-item">
            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Profile" asp-action="AdminUserList">
                Passengers (@roleLabel)
            </a>
        </li>
    }

    <li class="nav-item">
        <a class="nav-link text-white fw-semibold" asp-area="" asp-controller="Profile" asp-action="Index" title="View Profile">
            My Profile
        </a>
    </li>
    <li class="nav-item">
        <span class="nav-link text-white">Hello, @(currentUser?.Email)!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-white" style="cursor:pointer; text-decoration: none;">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>