@model AirlineFlightManagementWeb.Models.ViewModels.Payment.ProcessPaymentViewModel
@{
    ViewData["Title"] = "Reservation Checkout";
}

<div class="container mt-4">
    <h1 class="mb-4">Checkout</h1>

    @* Erori globale (din service: BR violations, sume gresite, etc.) *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

    <div class="row">
        @* ─── Coloana stanga: detalii zbor (read-only) ───────────────── *@
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <strong>Reservation Details</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Airline</dt>
                        <dd class="col-sm-7">@Model.AirlineName</dd>

                        <dt class="col-sm-5">Route</dt>
                        <dd class="col-sm-7">@Model.Source &rarr; @Model.Destination</dd>

                        <dt class="col-sm-5">Departure</dt>
                        <dd class="col-sm-7">@Model.DepartureTime.ToString("dd MMM yyyy HH:mm")</dd>

                        <dt class="col-sm-5">Seat</dt>
                        <dd class="col-sm-7">@Model.SeatNumber</dd>

                        <dt class="col-sm-5"><strong>Total</strong></dt>
                        <dd class="col-sm-7"><strong class="text-primary">@Model.TotalPrice.ToString("C")</strong></dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ─── Coloana dreapta: formularul de plata ─────────────────────── *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <strong>Payment Data</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Process" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReservationId" />

                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                            <select asp-for="PaymentMethod" asp-items="Model.AvailablePaymentMethods" class="form-select">
                                <option value="">-- Choose --</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        @* In productie aici ar fi campuri de card. La noi simulam. *@
                        <div class="alert alert-info small">
                            <em>Simulation: real card details are not requested. Click "Pay" to finalize your reservation.</em>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@Model.ReservationId" class="btn btn-outline-secondary">
                                Back
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Pay @Model.TotalPrice.ToString("C")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
