@model IEnumerable<AirlineFlightManagement.Models.Models.PassengerProfile>
@{
    ViewData["Title"] = "Passenger & Account Management";
    var isAdmin = User.IsInRole("Administrator");
}

<div class="mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Complete list of registered passengers in the system.</p>
    <hr />

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover border box-shadow align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Passenger ID</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Phone Number</th>
                    <th>Account Status</th>
                    @if (isAdmin)
                    {
                        <th class="text-center">Administrative Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isActive = item.UserAccount?.IsActive ?? false;
                    var email = item.UserAccount?.Email ?? "N/A";

                    <tr>
                        <td class="fw-bold">#@item.PassengerId</td>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@email</td>
                        <td>@item.PhoneNumber</td>
                        <td>
                            @if (isActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deactivated</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="AssignRole" asp-route-userId="@item.UserId" asp-route-email="@email" class="btn btn-sm btn-outline-primary">
                                        Change Role
                                    </a>

                                    @if (isActive)
                                    {
                                        <form asp-action="DeactivateUser" method="post" onsubmit="return confirm('Are you sure you want to deactivate this account?');">
                                            <input type="hidden" name="userId" value="@item.UserId" />
                                            <button type="submit" class="btn btn-sm btn-danger">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary" disabled>Deactivated</button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>