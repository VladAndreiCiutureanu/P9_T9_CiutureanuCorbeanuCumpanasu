@model AirlineFlightManagement.Models.ViewModels.UserRoleAssignViewModel
@{
    ViewData["Title"] = "System Role Assignment";
}

<div class="row mt-4">
    <div class="col-md-5">
        <h2>@ViewData["Title"]</h2>
        <hr />

        <div class="card box-shadow mt-3">
            <div class="card-body">
                <form asp-action="AssignRole" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />

                    <div class="form-group mb-3">
                        <label class="control-label fw-bold text-muted">User Account:</label>
                        <input class="form-control bg-light" value="@Model.Email" readonly />
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="SelectedRole" class="control-label fw-bold"></label>
                        <select asp-for="SelectedRole" class="form-select">
                            <option value="">-- Select new role --</option>
                            <option value="Administrator">Administrator</option>
                            <option value="Staff">Staff</option>
                            <option value="Customer">Customer (Passenger)</option>
                        </select>
                        <span asp-validation-for="SelectedRole" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary me-2">Apply Role</button>
                    <a asp-action="AdminUserList" class="btn btn-secondary">Back to List</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}