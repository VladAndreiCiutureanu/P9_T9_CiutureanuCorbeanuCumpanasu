@using AirlineFlightManagement.Models.Enums
@model AirlineFlightManagementWeb.Models.ViewModels.Reservation.MyReservationsViewModel
@{
    ViewData["Title"] = "Rezervarile mele";
}

<div class="container mt-4">
    <h1 class="mb-4">Rezervarile mele</h1>

    @* ─── Notificari TempData ─────────────────────────────────────────── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    @if (!Model.Reservations.Any())
    {
        @* ─── Empty state ─────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <p class="mb-2">Nu ai inca nicio rezervare.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    Cauta zboruri
                </a>
            </div>
        </div>
    }
    else
    {
        @* ─── Tabel cu rezervari ──────────────────────────────────────── *@
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Companie</th>
                        <th>Ruta</th>
                        <th>Plecare</th>
                        <th>Loc</th>
                        <th>Pret</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reservations)
                    {
                        <tr>
                            <td>@r.AirlineName</td>
                            <td>@r.Source &rarr; @r.Destination</td>
                            <td>@r.DepartureTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@r.SeatNumber</td>
                            <td><strong>@r.TotalPrice.ToString("C")</strong></td>
                            <td>
                                @switch (r.Status)
                                {
                                    case ReservationStatus.ConfirmedAndPaid:
                                        <span class="badge bg-success">Confirmata</span>
                                        break;
                                    case ReservationStatus.Pending:
                                        <span class="badge bg-warning text-dark">In asteptare</span>
                                        break;
                                    case ReservationStatus.Cancelled:
                                        <span class="badge bg-secondary">Anulata</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.ReservationId" class="btn btn-sm btn-outline-primary">
                                    Detalii
                                </a>
                                @if (r.CanPay)
                                {
                                    <a asp-controller="Payments" asp-action="Process" asp-route-reservationId="@r.ReservationId" class="btn btn-sm btn-success">
                                        Plateste
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
