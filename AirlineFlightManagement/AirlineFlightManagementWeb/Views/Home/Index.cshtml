@{
    ViewData["Title"] = "Home Page";
}

<div class="row mb-5">
    <div class="col-12">
        <div class="hero-section text-center text-white py-5 px-3 box-shadow">
            <div>
                <h1 class="display-3 fw-bold mb-3">Your Journey Starts Here</h1>
                <p class="lead mb-4 fs-4">Discover the world with Airline Flight Management</p>
                <a asp-controller="Flights" asp-action="Search" class="btn btn-lg text-white px-5 py-3 shadow border-0 fw-bold" style="background-color: #ff8c00; font-size: 1.2rem;">
                    Find Your Flight
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body py-4">
                <div class="display-4 text-warning mb-3">✈️</div>
                <h4 class="fw-bold">Easy Booking</h4>
                <p class="text-muted">Find and book your flights in just a few clicks.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body py-4">
                <div class="display-4 text-success mb-3">🛡️</div>
                <h4 class="fw-bold">Secure Payments</h4>
                <p class="text-muted">Your transactions are safe with our platform.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body py-4">
                <div class="display-4 text-primary mb-3">🌍</div>
                <h4 class="fw-bold">Global Destinations</h4>
                <p class="text-muted">Travel anywhere with confidence.</p>
            </div>
        </div>
    </div>
</div>
