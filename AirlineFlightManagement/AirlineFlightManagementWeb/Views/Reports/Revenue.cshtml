@model AirlineFlightManagementWeb.Models.ViewModels.Report.RevenueReportViewModel
@{
    ViewData["Title"] = "Raport venituri";
}

<div class="container mt-4">
    <h1 class="mb-3">Raport venituri</h1>
    <p class="text-muted small mb-4">REQ-44 — vizibil doar pentru Administratori. Agregare zilnica.</p>

    @* ─── Filtru de date ──────────────────────────────────────────────── *@
    <form method="get" asp-action="Revenue" class="row g-3 mb-4">
        <div class="col-auto">
            <label class="form-label">De la</label>
            <input type="date" name="from"
                   value="@(Model.From?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">Pana la</label>
            <input type="date" name="to"
                   value="@(Model.To?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Aplica</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Inapoi</a>
        </div>
    </form>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

    @* ─── Sumar agregat ───────────────────────────────────────────────── *@
    @if (Model.Rows.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card text-center border-success">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Total incasari</h6>
                        <h3 class="mb-0 text-success">@Model.GrandTotal.ToString("C")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Tranzactii</h6>
                        <h3 class="mb-0">@Model.TotalTransactions</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Medie zilnica</h6>
                        <h3 class="mb-0">@Model.AverageDailyRevenue.ToString("C")</h3>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ─── Tabel rezultate ─────────────────────────────────────────────── *@
    @if (!Model.Rows.Any())
    {
        <div class="alert alert-info">Nicio tranzactie completata in intervalul selectat.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th class="text-end">Tranzactii</th>
                        <th class="text-end">Incasari</th>
                        <th class="text-end">Medie / tranzactie</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Date.ToString("dd MMM yyyy")</td>
                            <td class="text-end">@row.TransactionsCount</td>
                            <td class="text-end"><strong>@row.TotalRevenue.ToString("C")</strong></td>
                            <td class="text-end">@row.AveragePerTransaction.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th>Total</th>
                        <th class="text-end">@Model.TotalTransactions</th>
                        <th class="text-end">@Model.GrandTotal.ToString("C")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
