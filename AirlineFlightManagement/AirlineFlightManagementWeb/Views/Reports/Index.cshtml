@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">
    <h1 class="mb-4">Reports</h1>
    <p class="text-muted mb-4">Select a report to view.</p>

    <div class="row g-3">
        @* ─── Card raport ocupare (Admin + Staff) ─────────────────────── *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Flight Occupancy</h5>
                    <p class="card-text text-muted small">
                        The percentage of sold seats for each flight within a time interval.
                    </p>
                    <a asp-action="Occupancy" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>

        @* ─── Card raport financiar (doar Admin) ──────────────────────── *@
        @if (User.IsInRole("Administrator"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h5 class="card-title">Revenue</h5>
                        <p class="card-text text-muted small">
                            Daily aggregated financial report. Visible only strictly to Administrators.
                        </p>
                        <a asp-action="Revenue" class="btn btn-warning">Open</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
