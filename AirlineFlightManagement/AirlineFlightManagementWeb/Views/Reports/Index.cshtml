@{
    ViewData["Title"] = "Rapoarte";
}

<div class="container mt-4">
    <h1 class="mb-4">Rapoarte</h1>
    <p class="text-muted mb-4">Selecteaza un raport pentru a-l vizualiza.</p>

    <div class="row g-3">
        @* ─── Card raport ocupare (Admin + Staff) ─────────────────────── *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Ocupare zboruri</h5>
                    <p class="card-text text-muted small">
                        Procentul de locuri vandute pentru fiecare zbor dintr-un interval de timp.
                    </p>
                    <a asp-action="Occupancy" class="btn btn-primary">Deschide</a>
                </div>
            </div>
        </div>

        @* ─── Card raport financiar (doar Admin) ──────────────────────── *@
        @if (User.IsInRole("Administrator"))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h5 class="card-title">Venituri</h5>
                        <p class="card-text text-muted small">
                            Raport financiar agregat zilnic. Vizibil doar pentru Administratori.
                        </p>
                        <a asp-action="Revenue" class="btn btn-warning">Deschide</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
